# No configuration: login with demo / demo123456 to view simulated data only.
# Administrator: run npm run setup to create private configuration and SESSION_SECRET.
SESSION_SECRET=
# Local config file. Empty means .slzb/accounts.json when it exists.
PORTAL_CONFIG_FILE=
# Vercel: paste the entire .slzb/vercel-config.json produced by npm run config:export.
# This has priority over PORTAL_CONFIG_FILE. Never prefix it with NEXT_PUBLIC_.
PORTAL_CONFIG_JSON=
# Optional shared Neon Postgres database; snapshots are isolated by account.
DATABASE_URL=
# Optional cron secret, at least 32 characters; openssl rand -hex 32.
CRON_SECRET=
