# Fixed owner (immutable in the web portal). Generate values with npm run admin:setup.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
# Optional display name; default 管理员.
ADMIN_DISPLAY_NAME=
SESSION_SECRET=
# 32-byte AES key, encoded as 64 hex characters. Back up; do not rotate without migration.
CONFIG_ENCRYPTION_KEY=
# Neon Postgres is REQUIRED for managed mode on Vercel.
DATABASE_URL=
# Optional background collection secret, at least 32 characters.
CRON_SECRET=
# Local managed storage only. Never used as a cloud persistence fallback.
ADMIN_STORE_FILE=
# Legacy read-only configuration mode; ignored when fixed administrator is configured.
PORTAL_CONFIG_FILE=
PORTAL_CONFIG_JSON=
