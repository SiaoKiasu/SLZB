# demo: works immediately without keys. binance: real read-only account.
DATA_SOURCE=demo
ACCOUNT_LABEL=我的现货账户
# Separate history when switching accounts. Do not reuse this ID for another account.
ACCOUNT_ID=main
BINANCE_ENV=mainnet
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Binance cannot enumerate all historical traded symbols. Include closed positions too.
# Maximum 20 pairs; each refresh fetches the latest 100 trades per pair.
TRACKED_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT
# Required in live mode: >= 12 characters. Use a long random password.
PORTAL_PASSWORD=
# Required when using password or live mode: >= 32 characters; openssl rand -hex 32
SESSION_SECRET=
# Optional automation/API bearer token: >= 32 characters; separate from login password.
MONITOR_API_TOKEN=
# Optional Neon Postgres connection string; enables persistent equity snapshots.
DATABASE_URL=
# Required for scheduled snapshots: >= 32 characters; openssl rand -hex 32
CRON_SECRET=
# Optional: equity at your chosen starting time, in USDT.
PERFORMANCE_BASELINE_USDT=
PERFORMANCE_BASELINE_AT=
# Net deposits minus withdrawals SINCE the baseline, including internal transfers.
# Explicitly set 0 only when there have been no net flows. Update after any transfer.
PERFORMANCE_NET_FLOWS_USDT=
# Optional remaining-position average costs in USDT, inclusive of fees.
# Maintain these when buying/selling/transferring assets; not auto-derived from partial trades.
COST_BASIS_JSON={}
# Example: COST_BASIS_JSON={"BTC":"58000","ETH":"2300"}
