{
  "openapi": "3.1.0",
  "info": {
    "title": "SLZB Spot Monitor",
    "version": "0.6.2",
    "description": "多用户现货监控：普通用户只读绑定账户；管理员可切换启用账户并维护手工成本。持久 Cookie 自动续期。"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local; replace with your deployment URL"
    }
  ],
  "security": [
    {
      "sessionCookie": []
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "health",
        "summary": "服务存活检查",
        "security": [],
        "responses": {
          "200": {
            "description": "Service running"
          }
        }
      }
    },
    "/api/session": {
      "get": {
        "operationId": "session",
        "summary": "验证会话",
        "responses": {
          "200": {
            "description": "Authenticated"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "post": {
        "operationId": "login",
        "summary": "用户名及密码登录（同源 Origin 必需）",
        "security": [],
        "parameters": [
          {
            "$ref": "#/components/parameters/Origin"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "password"],
                "properties": {
                  "password": {
                    "type": "string",
                    "format": "password"
                  },
                  "username": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User info and persistent HttpOnly slzb_session cookie; Max-Age=31536000; rolls forward after one day of activity."
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "delete": {
        "operationId": "logout",
        "summary": "清除会话（同源 Origin 必需）",
        "parameters": [
          {
            "$ref": "#/components/parameters/Origin"
          }
        ],
        "responses": {
          "200": {
            "description": "Cookie cleared"
          }
        }
      }
    },
    "/api/dashboard": {
      "get": {
        "operationId": "dashboard",
        "summary": "聚合账户数据，不写快照",
        "responses": {
          "200": {
            "description": "Dashboard",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Dashboard"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "parameters": [
          {
            "name": "accountId",
            "in": "query",
            "required": false,
            "description": "管理员可选择任一启用账户；普通用户始终使用绑定账户。",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/holdings": {
      "get": {
        "operationId": "holdings",
        "summary": "全部非零现货持仓",
        "responses": {
          "200": {
            "description": "Holdings envelope",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Holding"
                      }
                    },
                    "updatedAt": {
                      "type": "integer"
                    },
                    "warnings": {
                      "$ref": "#/components/schemas/Warnings"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "parameters": [
          {
            "name": "accountId",
            "in": "query",
            "required": false,
            "description": "管理员可选择任一启用账户；普通用户始终使用绑定账户。",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/pnl": {
      "get": {
        "operationId": "pnl",
        "summary": "现货 Equity、管理员成本口径盈亏、现金与本金",
        "responses": {
          "200": {
            "description": "Summary envelope",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Summary"
                    },
                    "updatedAt": {
                      "type": "integer"
                    },
                    "warnings": {
                      "$ref": "#/components/schemas/Warnings"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "parameters": [
          {
            "name": "accountId",
            "in": "query",
            "required": false,
            "description": "管理员可选择任一启用账户；普通用户始终使用绑定账户。",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/trades": {
      "get": {
        "operationId": "trades",
        "summary": "最近成交或单交易对 ID 分页",
        "parameters": [
          {
            "name": "symbol",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Must be in TRACKED_SYMBOLS"
          },
          {
            "name": "fromId",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^[0-9]{1,16}$"
            },
            "description": "Requires symbol. Use 0 to begin forward pagination."
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 100
            },
            "description": "Requires symbol"
          },
          {
            "name": "accountId",
            "in": "query",
            "required": false,
            "description": "管理员可选择任一启用账户；普通用户始终使用绑定账户。",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Trade envelope or paginated response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Trade"
                      }
                    },
                    "nextFromId": {
                      "type": ["string", "null"]
                    },
                    "coverage": {
                      "type": "string"
                    },
                    "updatedAt": {
                      "type": "integer"
                    },
                    "warnings": {
                      "$ref": "#/components/schemas/Warnings"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/orders": {
      "get": {
        "operationId": "orders",
        "summary": "当前现货挂单",
        "responses": {
          "200": {
            "description": "Orders envelope",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Order"
                      }
                    },
                    "updatedAt": {
                      "type": "integer"
                    },
                    "warnings": {
                      "$ref": "#/components/schemas/Warnings"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "parameters": [
          {
            "name": "accountId",
            "in": "query",
            "required": false,
            "description": "管理员可选择任一启用账户；普通用户始终使用绑定账户。",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/history": {
      "get": {
        "operationId": "history",
        "summary": "近 90 天净值，每小时末点",
        "responses": {
          "200": {
            "description": "History envelope",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Snapshot"
                      }
                    },
                    "updatedAt": {
                      "type": "integer"
                    },
                    "warnings": {
                      "$ref": "#/components/schemas/Warnings"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "parameters": [
          {
            "name": "accountId",
            "in": "query",
            "required": false,
            "description": "管理员可选择任一启用账户；普通用户始终使用绑定账户。",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/connection": {
      "get": {
        "operationId": "connection",
        "summary": "不含密钥的连接及覆盖状态",
        "responses": {
          "200": {
            "description": "Connection envelope",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "allOf": [
                        {
                          "$ref": "#/components/schemas/Connection"
                        },
                        {
                          "type": "object",
                          "properties": {
                            "source": {
                              "type": "string"
                            },
                            "environment": {
                              "type": "string"
                            }
                          }
                        }
                      ]
                    },
                    "updatedAt": {
                      "type": "integer"
                    },
                    "warnings": {
                      "$ref": "#/components/schemas/Warnings"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        },
        "parameters": [
          {
            "name": "accountId",
            "in": "query",
            "required": false,
            "description": "管理员可选择任一启用账户；普通用户始终使用绑定账户。",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/sync": {
      "post": {
        "operationId": "sync",
        "summary": "同步数据并尝试保存快照；Cookie 调用需要同源 Origin",
        "parameters": [
          {
            "$ref": "#/components/parameters/Origin"
          },
          {
            "name": "accountId",
            "in": "query",
            "required": false,
            "description": "管理员可选择任一启用账户；普通用户始终使用绑定账户。",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Dashboard; check connection.snapshotsSaved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Dashboard"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/cron": {
      "get": {
        "operationId": "cron",
        "summary": "管理员后台采集启用的真实账户",
        "security": [
          {
            "cronBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "All requested snapshots saved; includes results per account."
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        },
        "parameters": [
          {
            "name": "accountId",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Optional administrator-only account filter; user routes cannot select an account."
          }
        ]
      }
    },
    "/api/costs": {
      "get": {
        "summary": "管理员读取选定账户的手工成本",
        "responses": {
          "200": {
            "description": "costs, revision, updatedAt, updatedBy, writable"
          },
          "403": {
            "description": "需要管理员角色"
          },
          "404": {
            "description": "所选账户不存在或已停用"
          }
        },
        "parameters": [
          {
            "name": "accountId",
            "in": "query",
            "required": false,
            "description": "管理员可选择任一启用账户；普通用户始终使用绑定账户。",
            "schema": {
              "type": "string"
            }
          }
        ],
        "description": "需要管理员角色，按 accountId 选择启用账户。写入还需同源 Origin。成本完全手动维护。"
      },
      "put": {
        "summary": "管理员保存持仓成本并重算未实现盈亏",
        "description": "需要管理员角色，按 accountId 选择启用账户。写入还需同源 Origin。成本完全手动维护。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["costs", "revision"],
                "additionalProperties": false,
                "properties": {
                  "revision": {
                    "type": ["string", "null"],
                    "format": "uuid"
                  },
                  "costs": {
                    "type": "object",
                    "maxProperties": 500,
                    "additionalProperties": {
                      "type": "string",
                      "pattern": "^\\d{1,20}(\\.\\d{1,16})?$"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "已保存的成本及修改元数据"
          },
          "400": {
            "description": "无效参数"
          },
          "403": {
            "description": "角色或 Origin 无效"
          },
          "409": {
            "description": "版本冲突，需重新读取"
          },
          "503": {
            "description": "云端缺少持久数据库"
          },
          "404": {
            "description": "所选账户不存在或已停用"
          }
        },
        "parameters": [
          {
            "name": "accountId",
            "in": "query",
            "required": false,
            "description": "管理员可选择任一启用账户；普通用户始终使用绑定账户。",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "slzb_session"
      },
      "cronBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "CRON_SECRET, separate from API token"
      }
    },
    "parameters": {
      "Origin": {
        "name": "Origin",
        "in": "header",
        "schema": {
          "type": "string",
          "format": "uri"
        },
        "description": "Cookie 写请求必须携带与服务地址一致的 Origin。"
      }
    },
    "responses": {
      "Error": {
        "description": "Sanitized error",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": ["error"],
              "properties": {
                "error": {
                  "type": "object",
                  "required": ["code", "message"],
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "schemas": {
      "Amount": {
        "type": "string",
        "description": "Decimal string, may use exponent notation for dust"
      },
      "NullableAmount": {
        "type": ["string", "null"],
        "description": "null means unknown, never zero"
      },
      "Warnings": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "Holding": {
        "type": "object",
        "properties": {
          "asset": {
            "type": "string"
          },
          "free": {
            "$ref": "#/components/schemas/Amount"
          },
          "locked": {
            "$ref": "#/components/schemas/Amount"
          },
          "quantity": {
            "$ref": "#/components/schemas/Amount"
          },
          "price": {
            "$ref": "#/components/schemas/NullableAmount"
          },
          "value": {
            "$ref": "#/components/schemas/NullableAmount"
          },
          "allocation": {
            "type": "number"
          },
          "change24h": {
            "type": ["number", "null"]
          },
          "averageCost": {
            "$ref": "#/components/schemas/NullableAmount"
          },
          "unrealizedPnl": {
            "$ref": "#/components/schemas/NullableAmount",
            "description": "稳定币固定为 null（界面显示 —），其他资产按管理员单位成本计算。"
          }
        }
      },
      "Trade": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "symbol": {
            "type": "string"
          },
          "side": {
            "enum": ["BUY", "SELL"]
          },
          "price": {
            "$ref": "#/components/schemas/Amount"
          },
          "quantity": {
            "$ref": "#/components/schemas/Amount"
          },
          "quoteQuantity": {
            "$ref": "#/components/schemas/Amount"
          },
          "fee": {
            "$ref": "#/components/schemas/Amount"
          },
          "feeAsset": {
            "type": "string"
          },
          "time": {
            "type": "integer"
          },
          "isMaker": {
            "type": "boolean"
          }
        }
      },
      "Order": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "symbol": {
            "type": "string"
          },
          "side": {
            "enum": ["BUY", "SELL"]
          },
          "type": {
            "type": "string"
          },
          "price": {
            "$ref": "#/components/schemas/Amount"
          },
          "quantity": {
            "$ref": "#/components/schemas/Amount"
          },
          "executedQuantity": {
            "$ref": "#/components/schemas/Amount"
          },
          "status": {
            "type": "string"
          },
          "time": {
            "type": "integer"
          }
        }
      },
      "Snapshot": {
        "type": "object",
        "properties": {
          "time": {
            "type": "integer"
          },
          "equity": {
            "$ref": "#/components/schemas/Amount"
          }
        }
      },
      "Summary": {
        "type": "object",
        "properties": {
          "equity": {
            "$ref": "#/components/schemas/Amount",
            "description": "优先读取 Binance Spot 钱包 balance（quoteAsset=USDT）；失败或测试网才按余额与行情估算。不含其他钱包。"
          },
          "pricedAssets": {
            "type": "integer"
          },
          "unpricedAssets": {
            "type": "integer"
          },
          "unrealizedPnl": {
            "$ref": "#/components/schemas/NullableAmount",
            "description": "仅汇总非稳定币持仓浮盈；非稳定币成本或行情缺失时为 null。"
          },
          "costCoverage": {
            "type": "integer"
          },
          "totalPnl": {
            "$ref": "#/components/schemas/NullableAmount"
          },
          "baseline": {
            "$ref": "#/components/schemas/NullableAmount"
          },
          "baselineAt": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "netFlows": {
            "$ref": "#/components/schemas/NullableAmount"
          },
          "stablecoinValue": {
            "$ref": "#/components/schemas/Amount"
          },
          "tradeCount": {
            "type": "integer"
          },
          "realizedPnl": {
            "$ref": "#/components/schemas/NullableAmount",
            "description": "按成交记录核算平仓收益，减全部即时发生的买卖手续费；买入费用不再重复计入卖出成本。同步中可返回已读取成交暂计值。"
          },
          "principal": {
            "$ref": "#/components/schemas/NullableAmount"
          },
          "cash": {
            "$ref": "#/components/schemas/Amount"
          },
          "cashFree": {
            "$ref": "#/components/schemas/Amount"
          },
          "cashLocked": {
            "$ref": "#/components/schemas/Amount"
          },
          "realizedPnlNote": {
            "type": "string",
            "description": "成交盈亏口径或无法计算原因：历史同步、缺历史买入、缺手续费历史汇率、跨币成交等。"
          },
          "equitySource": {
            "type": "string",
            "enum": ["exchange", "calculated"],
            "description": "总资产来自交易所接口或本地估算；演示数据为 calculated。"
          },
          "equityComplete": {
            "type": "boolean",
            "description": "有官方现货估值，或全部持仓本地估值完整时为 true。false 时 equity 仅为已估值资产小计，暂停快照。"
          },
          "realizedPnlComplete": {
            "type": "boolean",
            "description": "首次回溯已完成且已读取成交可完整核算。false 时数值为暂计，可能随同步补齐调整。"
          },
          "feePnl": {
            "$ref": "#/components/schemas/NullableAmount",
            "description": "已读取成交手续费即时折算 USDT 后的负值；缺汇率或跨币成交等无法完整核算时为 null。"
          }
        }
      },
      "Connection": {
        "type": "object",
        "properties": {
          "database": {
            "type": "boolean"
          },
          "snapshotsSaved": {
            "type": "boolean"
          },
          "symbols": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tradesComplete": {
            "type": "boolean",
            "description": "All discovered pairs initially paginated; not proof of complete account lifetime history"
          },
          "ordersComplete": {
            "type": "boolean"
          },
          "historySync": {
            "type": "object",
            "properties": {
              "scanned": {
                "type": "integer"
              },
              "total": {
                "type": "integer"
              },
              "oldestCheck": {
                "type": ["integer", "null"]
              }
            }
          }
        }
      },
      "Dashboard": {
        "type": "object",
        "properties": {
          "source": {
            "enum": ["demo", "binance"]
          },
          "accountLabel": {
            "type": "string"
          },
          "environment": {
            "type": "string"
          },
          "updatedAt": {
            "type": "integer"
          },
          "summary": {
